<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>네온 티라노 게임</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #111;
            font-family: 'Courier New', Courier, monospace;
            color: white;
            transition: background-color 1s ease;
        }
        canvas {
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            transition: background-color 1s ease;
        }
        #instructions {
            margin-top: 20px;
            text-align: center;
            color: #aaa;
        }
    </style>
</head>
<body>

    <h1>NEON T-REX</h1>
    <canvas id="gameCanvas" width="800" height="300"></canvas>
    <div id="instructions">
        스페이스바(Space) 또는 위쪽 화살표(↑)를 눌러 점프하세요!<br>
        (화면을 터치하거나 클릭해도 점프가 가능합니다)
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // 게임 상태 변수
        let score = 0;
        let gameSpeed = 6;
        let isGameOver = false;
        let frameCount = 0;

        // 테마 설정 (정글 -> 바다 -> 화산)
        const themes = [
            { name: "JUNGLE", bg: '#0b240b', ground: '#1e5e1e', obstacle: '#4caf50' },
            { name: "OCEAN", bg: '#09152b', ground: '#1a3b70', obstacle: '#2196f3' },
            { name: "VOLCANO", bg: '#2b0a0a', ground: '#701a1a', obstacle: '#f44336' }
        ];

        // 플레이어(티라노) 객체
        const dino = {
            x: 50,
            y: 200,
            w: 40,
            h: 50,
            dy: 0,
            gravity: 0.6,
            jumpPower: -11,
            isGrounded: true,
            
            draw() {
                ctx.save();
                // 네온 효과 설정 (내부와 테두리)
                ctx.shadowBlur = 15;
                ctx.shadowColor = '#00ffff'; 
                ctx.fillStyle = 'rgba(0, 255, 255, 0.4)'; // 반투명한 내부
                ctx.strokeStyle = '#ffffff'; // 하얀색 테두리
                ctx.lineWidth = 2;

                // 단순화된 티라노 모양 그리기 (Path)
                ctx.beginPath();
                ctx.rect(this.x + 20, this.y, 20, 20);      // 머리
                ctx.rect(this.x + 10, this.y + 20, 25, 20); // 몸통
                ctx.rect(this.x, this.y + 20, 10, 10);      // 꼬리
                ctx.rect(this.x + 10, this.y + 40, 6, 10);  // 왼쪽 다리
                ctx.rect(this.x + 25, this.y + 40, 6, 10);  // 오른쪽 다리
                
                ctx.fill();
                ctx.stroke();
                ctx.restore();
            },

            update() {
                // 중력 적용
                if (!this.isGrounded) {
                    this.dy += this.gravity;
                }
                this.y += this.dy;

                // 바닥 충돌 체크
                if (this.y >= 200) {
                    this.y = 200;
                    this.dy = 0;
                    this.isGrounded = true;
                }

                this.draw();
            },

            jump() {
                if (this.isGrounded) {
                    this.dy = this.jumpPower;
                    this.isGrounded = false;
                }
            }
        };

        // 장애물 배열
        let obstacles = [];

        class Obstacle {
            constructor() {
                this.w = 20 + Math.random() * 20;
                this.h = 30 + Math.random() * 40;
                this.x = canvas.width;
                this.y = 250 - this.h;
            }

            draw(theme) {
                ctx.save();
                ctx.shadowBlur = 10;
                ctx.shadowColor = theme.obstacle;
                ctx.fillStyle = theme.obstacle;
                
                // 네온 장애물
                ctx.fillRect(this.x, this.y, this.w, this.h);
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 1;
                ctx.strokeRect(this.x, this.y, this.w, this.h);
                ctx.restore();
            }

            update(theme) {
                this.x -= gameSpeed;
                this.draw(theme);
            }
        }

        // 장애물 생성
        function handleObstacles(theme) {
            // 랜덤한 주기로 장애물 추가
            if (frameCount % 100 === 0 || (frameCount % 60 === 0 && Math.random() > 0.5)) {
                obstacles.push(new Obstacle());
            }

            for (let i = 0; i < obstacles.length; i++) {
                obstacles[i].update(theme);

                // 충돌 판정 (AABB)
                if (
                    dino.x < obstacles[i].x + obstacles[i].w &&
                    dino.x + dino.w > obstacles[i].x &&
                    dino.y < obstacles[i].y + obstacles[i].h &&
                    dino.y + dino.h > obstacles[i].y
                ) {
                    isGameOver = true;
                }

                // 화면 밖으로 나간 장애물 제거
                if (obstacles[i].x + obstacles[i].w < 0) {
                    obstacles.splice(i, 1);
                    i--;
                }
            }
        }

        // 게임 배경 및 바닥 그리기
        function drawBackground(theme) {
            canvas.style.backgroundColor = theme.bg;
            document.body.style.backgroundColor = theme.bg === '#0b240b' ? '#051205' : (theme.bg === '#09152b' ? '#030a17' : '#140404');
            
            ctx.fillStyle = theme.ground;
            ctx.fillRect(0, 250, canvas.width, 50);

            // 테마 이름 표시
            ctx.fillStyle = 'rgba(255, 255, 255, 0.1)';
            ctx.font = 'bold 80px Courier New';
            ctx.textAlign = 'center';
            ctx.fillText(theme.name, canvas.width / 2, 160);
        }

        // 점수 표시
        function drawScore() {
            ctx.fillStyle = '#fff';
            ctx.font = '20px Courier New';
            ctx.textAlign = 'right';
            ctx.fillText(`SCORE: ${Math.floor(score)}`, canvas.width - 20, 30);
        }

        // 게임 루프
        function animate() {
            if (isGameOver) {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#fff';
                ctx.font = '30px Courier New';
                ctx.textAlign = 'center';
                ctx.fillText('GAME OVER', canvas.width / 2, canvas.height / 2 - 20);
                ctx.font = '20px Courier New';
                ctx.fillText(`최종 점수: ${Math.floor(score)}`, canvas.width / 2, canvas.height / 2 + 20);
                ctx.fillText('스페이스바를 눌러 재시작', canvas.width / 2, canvas.height / 2 + 60);
                return;
            }

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 1000점 단위로 테마 순환 (0: 정글, 1: 바다, 2: 화산)
            let themeIndex = Math.floor(score / 1000) % 3;
            let currentTheme = themes[themeIndex];

            drawBackground(currentTheme);
            dino.update();
            handleObstacles(currentTheme);
            drawScore();

            // 점수 및 속도 증가
            score += 1;
            frameCount++;
            if (score % 500 === 0) gameSpeed += 0.5; // 갈수록 조금씩 빨라짐

            requestAnimationFrame(animate);
        }

        // 입력 처리 (점프 및 재시작)
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' || e.code === 'ArrowUp') {
                if (isGameOver) {
                    resetGame();
                } else {
                    dino.jump();
                }
            }
        });

        canvas.addEventListener('mousedown', () => {
            if (isGameOver) resetGame();
            else dino.jump();
        });

        // 게임 초기화
        function resetGame() {
            score = 0;
            gameSpeed = 6;
            frameCount = 0;
            obstacles = [];
            isGameOver = false;
            dino.y = 200;
            dino.dy = 0;
            animate();
        }

        // 게임 시작
        animate();
    </script>
</body>
</html>
